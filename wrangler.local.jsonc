{
  // Offline config for UI testing on your own computer: no Cloudflare login needed.
  // Uses a local database and the MOCK scorer (dummy marks, not real evaluation).
  "name": "assessment-portal-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "assessment-portal-local", "database_id": "local" }],
  "vars": { "EVAL_PROVIDER": "mock" }
}
