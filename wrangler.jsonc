{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assessment-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id here on purpose: the first deploy creates the D1 database on your
      // Cloudflare account automatically, and later deploys keep using the same one.
      // Tables are created by the app itself on first visit.
      "database_name": "assessment-portal"
    }
  ],
  "ai": { "binding": "AI" },
  // Every 5 minutes: close attempts whose time is over but were never submitted (browser closed, network lost).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // "workers-ai"        -> Cloudflare Workers AI (POC, free daily allocation)
    // "openai-compatible" -> any OpenAI-style endpoint, e.g. a model on the college server
    // "mock"              -> offline dummy scorer, for UI testing only
    "EVAL_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "LLM_BASE_URL": "",
    "LLM_MODEL": ""
  },
  "observability": { "enabled": true }
}
